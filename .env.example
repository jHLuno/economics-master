# OpenRouter API key — used for chat completions (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override the default chat model. Default is `openai/gpt-oss-120b:free`
# (a free OpenRouter model that handles economics tutoring well).
# Other options: openai/gpt-4o-mini, anthropic/claude-3.5-haiku,
#   google/gemini-2.0-flash-001, meta-llama/llama-3.3-70b-instruct,
#   deepseek/deepseek-chat
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Optional: identify your app to OpenRouter (shown in their dashboard)
# OPENROUTER_SITE_URL=https://your-deployed-site.example
# OPENROUTER_APP_NAME=Economics Expert
